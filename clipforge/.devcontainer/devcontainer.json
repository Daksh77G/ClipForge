{
  "name": "clipforge",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "supabase.supabase"
      ]
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y ffmpeg && npm install"
}